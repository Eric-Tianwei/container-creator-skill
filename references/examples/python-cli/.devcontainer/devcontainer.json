{
  "name": "python-cli",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "initializeCommand": "bash .devcontainer/bin/init-volumes.sh",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
    "source=dcc.cache.${localWorkspaceFolderBasename}.venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=dcc.cache.${localWorkspaceFolderBasename}.uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=dcc.proj.${localWorkspaceFolderBasename}.cmdhistory,target=/commandhistory,type=volume",
    "source=dcc.shared.user-local,target=/home/vscode/.local,type=volume",
    "source=dcc.shared.cargo-bin,target=/home/vscode/.cargo/bin,type=volume",
    "source=dcc.shared.go-bin,target=/home/vscode/go/bin,type=volume",
    "source=dcc.shared.npm-global,target=/home/vscode/.npm-global,type=volume",
    "source=dcc.shared.pipx,target=/home/vscode/.local/pipx,type=volume",
    "source=dcc.shared.linuxbrew,target=/home/linuxbrew/.linuxbrew,type=volume"
  ],
  "containerEnv": {
    "EDITOR": "code --wait",
    "PAGER": "less -R",
    "TOOLS_LIST": "${containerWorkspaceFolder}/.devcontainer/tools.list",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "updateContentCommand": "[ -f pyproject.toml ] && uv sync --frozen || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "EditorConfig.EditorConfig",
        "usernamehw.errorlens",
        "mikestead.dotenv"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": { "source.fixAll": "explicit", "source.organizeImports": "explicit" }
        }
      }
    }
  }
}
