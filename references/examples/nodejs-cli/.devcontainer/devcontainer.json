{
  "name": "nodejs-cli",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "initializeCommand": "bash .devcontainer/bin/init-volumes.sh",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
    "source=dcc.cache.${localWorkspaceFolderBasename}.node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=dcc.proj.${localWorkspaceFolderBasename}.cmdhistory,target=/commandhistory,type=volume",
    "source=dcc.shared.user-local,target=/home/vscode/.local,type=volume",
    "source=dcc.shared.cargo-bin,target=/home/vscode/.cargo/bin,type=volume",
    "source=dcc.shared.go-bin,target=/home/vscode/go/bin,type=volume",
    "source=dcc.shared.npm-global,target=/home/vscode/.npm-global,type=volume",
    "source=dcc.shared.bun,target=/home/vscode/.bun,type=volume",
    "source=dcc.shared.linuxbrew,target=/home/linuxbrew/.linuxbrew,type=volume"
  ],
  "containerEnv": {
    "EDITOR": "code --wait",
    "PAGER": "less -R",
    "TOOLS_LIST": "${containerWorkspaceFolder}/.devcontainer/tools.list"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "updateContentCommand": "[ -f package.json ] && (corepack enable && pnpm install --frozen-lockfile) || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "EditorConfig.EditorConfig",
        "usernamehw.errorlens",
        "mikestead.dotenv"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
