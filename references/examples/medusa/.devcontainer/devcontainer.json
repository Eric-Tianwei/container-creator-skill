{
  "name": "medusa-stack",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "initializeCommand": "bash .devcontainer/bin/init-volumes.sh",
  "containerEnv": {
    "EDITOR": "code --wait",
    "PAGER": "less -R",
    "TOOLS_LIST": "${containerWorkspaceFolder}/.devcontainer/tools.list",
    "DATABASE_URL": "postgres://postgres:postgres@db:5432/medusa",
    "REDIS_URL": "redis://redis:6379",
    "MEDUSA_BACKEND_URL": "http://localhost:9000",
    "NEXT_PUBLIC_MEDUSA_BACKEND_URL": "http://localhost:9000"
  },
  "forwardPorts": [7001, 8000, 9000, 5432, 6379],
  "portsAttributes": {
    "7001": { "label": "Medusa Admin (dev)" },
    "8000": { "label": "Next.js Storefront", "onAutoForward": "openPreview" },
    "9000": { "label": "Medusa API" },
    "5432": { "label": "Postgres" },
    "6379": { "label": "Redis" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "updateContentCommand": "[ -f package.json ] && (corepack enable && pnpm install --frozen-lockfile) || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "EditorConfig.EditorConfig",
        "usernamehw.errorlens",
        "mikestead.dotenv",
        "cweijan.vscode-postgresql-client2",
        "cweijan.vscode-redis-client"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
